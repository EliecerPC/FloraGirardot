# Copia este archivo como ".env" y completa los valores.
# NUNCA subas el archivo .env a GitHub.

# --- Base de datos PostgreSQL ---
DB_USER=postgres
DB_HOST=localhost
DB_NAME=flora_girardot
DB_PASSWORD=
DB_PORT=5432

# --- Servidor ---
PORT=3000
NODE_ENV=development

# Clave para firmar las sesiones. Genera una con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Orígenes del frontend permitidos por CORS (separados por coma)
FRONTEND_URL=http://127.0.0.1:5500,http://localhost:5500